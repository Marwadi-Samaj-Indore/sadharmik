# =============================================================================
# Marwadi Samaj Indore app — connection settings
#
# HOW TO USE THIS FILE
#   1. Make a copy of it named exactly  .env.local
#   2. Paste your own values in, replacing everything after the = sign
#   3. Save. Never share .env.local with anyone, and never post it in a chat.
#
# .env.local is already in .gitignore, so it will never be uploaded anywhere.
# =============================================================================

# From Supabase: Project Settings -> Data API -> Project URL
# Looks like:  https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# From Supabase: Project Settings -> API Keys -> anon / public
# This one is safe to be public. It is used only for signing in.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From Supabase: Project Settings -> API Keys -> service_role  (click "Reveal")
# ⚠️  SECRET. This key can read and change everything in your database.
#     Keep it only in this file. Never paste it into a chat, email or WhatsApp.
#     If it ever leaks, click "Reset" in Supabase to invalidate it.
SUPABASE_SERVICE_ROLE_KEY=

# Leave blank for now — filled in after the Vercel deploy, so Google sign-in
# knows where to send members back to. Example: https://sadharmik.in
NEXT_PUBLIC_SITE_URL=

# Optional. Signs the sign-in cookies so nobody can forge one and appear as
# another member. If you leave it blank the service-role key above is used
# instead, which works fine — set this only if you want to sign everyone out
# (change the value) without touching your Supabase keys. Any long random
# string will do.
SESSION_SECRET=

# The committee's shared sign-in code — the emergency way in if a committee
# member's Google sign-in ever fails. Pick something long, and change it before
# launch. If it contains a # character, put the whole value in "double quotes",
# or everything after the # is silently ignored.
ADMIN_ACCESS_CODE=
